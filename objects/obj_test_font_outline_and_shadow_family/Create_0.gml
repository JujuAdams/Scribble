scribble_font_bake_outline_and_shadow("fnt_style",    "fnt_style_mod",    3, 3, SCRIBBLE_OUTLINE.EIGHT_DIR_THICK, 0, true);
scribble_font_bake_outline_and_shadow("fnt_style_b",  "fnt_style_b_mod",  3, 3, SCRIBBLE_OUTLINE.EIGHT_DIR_THICK, 0, true);
scribble_font_bake_outline_and_shadow("fnt_style_i",  "fnt_style_i_mod",  3, 3, SCRIBBLE_OUTLINE.EIGHT_DIR_THICK, 0, true);
scribble_font_bake_outline_and_shadow("fnt_style_bi", "fnt_style_bi_mod", 3, 3, SCRIBBLE_OUTLINE.EIGHT_DIR_THICK, 0, true);

scribble_font_set_style_family("fnt_style", "fnt_style_b", "fnt_style_i", "fnt_style_bi");
scribble_font_set_style_family("fnt_style_mod", "fnt_style_b_mod", "fnt_style_i_mod", "fnt_style_bi_mod");